# Signs the session cookie. The app refuses to start in production without it.
# Generate one: openssl rand -base64 32
SESSION_SECRET=

# Gates /admin. Without it that route 404s, which is the intended default.
ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# Inference location.
#
# UNSET  -> the ONNX graph runs in this process (onnxruntime-node). This is the
#           right setting locally and for the container deployment.
#
# SET    -> the forward pass is delegated to the FastAPI service at this URL.
#           Everything else -- feature extraction, aggregation and all of the
#           reasoning -- still runs here, on the same code either way.
#
#           This is the Vercel setting, because Vercel cannot carry the native
#           ONNX runtime comfortably but has no trouble with a TypeScript
#           extractor and a few KB of model metadata.
#
# parity/inference_mode_parity.mjs asserts the two settings produce identical
# rankings, tie flags, reasoning sentences and highlight offsets. Do not treat
# them as interchangeable without running it.
SUBJECTRANK_API_URL=
